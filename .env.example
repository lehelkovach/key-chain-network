# KeyChain Network configuration. Copy to .env (git-ignored) or feed to systemd
# via EnvironmentFile. Values shown are the defaults unless noted.

# --- required in any deployment that holds private keys -----------------------
# 32 bytes, hex or base64url. Seals trust root private keys, and agent keys minted
# with custody=keychain, at rest. Generate with:
#   python3 keychain_cli.py gen-master-key
# Losing it makes every key KeyChain holds unrecoverable.
KEYCHAIN_MASTER_KEY=

# Local development only: store private keys unsealed instead of setting a master
# key. /health reports key_custody_sealed=false so this is visible from outside.
# KEYCHAIN_ALLOW_PLAINTEXT_KEYS=1

# --- service -----------------------------------------------------------------
# Bearer token for every route except /health and the two .well-known documents.
# Leave empty to disable auth (local development only).
KEYCHAIN_API_TOKEN=
KEYCHAIN_HOST=0.0.0.0
KEYCHAIN_PORT=8102
KEYCHAIN_DB_PATH=keychain.db
KEYCHAIN_LOG_LEVEL=INFO

# --- trust roots -------------------------------------------------------------
# Create a default trust root on first start if none exists. Prefer creating roots
# explicitly (POST /trust/roots or `keychain_cli.py init-root`) in production, so
# the root key id you pin is one you chose deliberately.
KEYCHAIN_AUTO_BOOTSTRAP_ROOT=0
KEYCHAIN_ROOT_NAME=local-dev-root
KEYCHAIN_ROOT_CERT_TTL_SECONDS=157680000

# --- minting -----------------------------------------------------------------
# random: agent_uuid is a UUIDv4, as ACP v2 specifies.
# derived: agent_uuid is a UUIDv5 over (trust root key id, logical handle), so
#          replicas sharing a root mint the same uuid for the same handle.
KEYCHAIN_UUID_MODE=random

# auto:   sign a child certificate with its parent's key when KeyChain holds it,
#         otherwise with the trust root.
# root:   always sign with the trust root.
# parent: require the parent's key; fail the mint if it is not in custody.
KEYCHAIN_ISSUER_MODE=auto

KEYCHAIN_AGENT_CERT_TTL_SECONDS=7776000

# --- tokens ------------------------------------------------------------------
# Comma-separated default audience for issued tokens. Set this to the relying
# parties you actually run.
KEYCHAIN_DEFAULT_AUDIENCE=iac-bus
KEYCHAIN_TOKEN_TTL_SECONDS=3600
KEYCHAIN_MAX_TOKEN_TTL_SECONDS=604800
